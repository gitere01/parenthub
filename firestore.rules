rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // ===================================
    // 👤 GLOBAL ACCESS FOR AUTHENTICATED USERS
    // ===================================
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // ===================================
    // 🌍 PUBLIC ACCESS FOR SIGN-IN / ACTIVATION
    // ===================================

    // Allow unauthenticated reads for invitations during the login/activation process
    match /staff_invites/{email} {
      allow read: if true;
    }

    match /parent_invites/{email} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
